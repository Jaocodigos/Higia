{% macro form_header(sections=[], with_revision=True) %}
    {% if sections %}

        <section class="h-32 w-full bg-gray-600 flex flex-row items-center justify-center text-slate-300">

            {% for s in sections %}


                <div id="{{s.get('id')}}" class="h-20 w-32 flex flex-col justify-center items-center m-2 bg-gray-700 rounded transition-opacity ease-in {% if loop.first %}opacity-100{% else %}opacity-40{% endif %}">
                    <p class="p-4">{{ s.get('title') }}</p>
                </div>
                <div class="h-1 w-10 bg-gray-800 rounded-xl space-steps"></div>


            {% endfor %}

            {% if with_revision %}
                <div id="revision-step" class="h-20 w-32 flex flex-col justify-center items-center m-2 bg-gray-700 rounded transition-opacity ease-in opacity-40">
                    <p class="p-4">Information Review</p>
                </div>
            {% endif %}


        </section>

    {% else %}

        <section class="h-32 w-full bg-gray-600 flex flex-row items-center justify-center text-slate-300">
            <div id="data-step" class="h-20 w-32 flex flex-col justify-center items-center m-2 bg-gray-700 rounded transition-opacity ease-in opacity-100">
                <p class="p-4">Insert Data</p>
            </div>
            {% if with_revision %}
                <div class="h-1 w-10 bg-gray-800 rounded-xl"></div>
                <div id="revision-step" class="h-20 w-32 flex flex-col justify-center items-center m-2 bg-gray-700 rounded transition-opacity ease-in opacity-40">

                    <p class="p-4">Information Review</p>
                </div>
            {% endif %}

        </section>

    {% endif %}

{% endmacro %}

{% macro render_form(form, sections=[], with_revision=True) %}

    <section class="h-1/2 w-full bg-gray-800 flex flex-col justify-center items-center">

        <form method="POST" enctype="multipart/form-data" class="h-full w-full flex flex-col justify-center items-center">
            {{ form.csrf_token }}

            {% if not sections %}

                <div id="h-form" class="flex flex-col justify-center items-center opacity-100 transition-opacity duration-300 ease-in-out absolute">
                    {% for field in form %}

                        {% if field.name != "csrf_token" and field.name != "submit" %}
                            <div class="m-2 flex flex-col ">
                                <label class="text-slate-300 text-xs">{{ field.label.text }}</label>
                                {{ field(class="h-input") }}
                            </div>
                        {% endif %}


                    {% endfor %}


                    {% if with_revision %}

                        <div class="flex flex-row mt-4">
                            <button onclick="backStep('h-form', 'data-step')" class="h-10 w-20 m-2 p-2 bg-transparent text-gray-300 border-solid border border-gray-500 transition ease-in hover:bg-gray-600 hover:text-slate-100 rounded shadow">
                                Back</button>

                            <button onclick="nextStep('h-form', 'revision-step')" type="button" class="h-10 w-20 m-2 p-2 bg-gray-700 text-gray-300 transition duration-300 ease-in hover:bg-gray-600 hover:text-slate-100 rounded shadow">
                                Next</button>
                        </div>
                    {% else %}
                        <div class="flex flex-row mt-4">

                            {{ form.submit(class="h-10 w-20 m-2 p-2 bg-gray-700 text-gray-300 cursor-pointer transition ease-in duration-300 hover:bg-gray-600 hover:text-slate-100 rounded shadow") }}
                        </div>
                    {% endif %}

                </div>

            {% else %}

                {% for s in sections %}

                    <div id="h-form-{{ s.get('id') }}" class="flex flex-col justify-center items-center {% if loop.first %}opacity-100{% else %}opacity-0 hidden{% endif %} transition-opacity duration-300 ease-in-out absolute">


                        {% for field in s.get("fields") %}

                            <div class="m-2 flex flex-col h-field">
                                <label class="text-slate-300 text-xs">{{ form[field].label.text }}</label>
                                {{ form[field](class="h-input") }}
                            </div>

                        {% endfor %}


                        {% if with_revision %}

                            <div class="flex flex-row mt-4">
                                <button onclick="backStep( 'h-form-{{ s.get('id') }}', '{{ s.get('step_id') }}' )" class="h-10 w-20 m-2 p-2 bg-transparent text-gray-300 border-solid border border-gray-500 transition duration-300 ease-in hover:bg-gray-600 hover:text-slate-100 rounded shadow">
                                    Back</button>

                                <button onclick="nextStep('h-form-{{ s.get('id') }}', '{{ s.get('step_id') }}')" type="button" class="h-10 w-20 m-2 p-2 bg-gray-700 text-gray-300 transition duration-300 ease-in hover:bg-gray-600 hover:text-slate-100 rounded shadow">
                                    Next</button>
                            </div>

                        {% else %}
                            <div class="flex flex-row mt-4">

                                {{ form.submit(class="h-10 w-20 m-2 p-2 bg-gray-700 text-gray-300 cursor-pointer transition ease-in duration-300 hover:bg-gray-600 hover:text-slate-100 rounded shadow") }}
                            </div>

                        {% endif %}

                    </div>

                {% endfor %}

            {% endif %}


            {% if with_revision %}
                <div id="h-form-revision" class="flex flex-col transition-opacity duration-500 ease-in-out hidden opacity-0 relative">

                    <!-- Revision Section -->

                    <div class="flex flex-row mt-4">
                        <button onclick="backStep('h-form-revision', 'revision-step')" type="button" class="h-10 w-20 m-2 p-2 bg-transparent text-gray-300 border-solid border border-gray-500 transition duration-300 ease-in hover:bg-gray-600 hover:text-slate-100 rounded shadow">
                            Back</button>
                        {{ form.submit(class="h-10 w-20 m-2 p-2 bg-gray-700 text-gray-300 cursor-pointer transition ease-in duration-300 hover:bg-gray-600 hover:text-slate-100 rounded shadow") }}
                    </div>
                </div>
            {% endif %}

        </form>



        <script>







        </script>
    </section>
{% endmacro %}


