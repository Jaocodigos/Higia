{% macro render_card(title, icon_url, subtitle="",options=[]) %}
    <div class="Ccard bg-gray-800 m-4 min-w-32 shadow-md rounded-lg overflow-hidden transition-transform duration-300 transform hover:scale-105 hover-visible relative">
       <div class="px-6 py-4 w-96 min-w-60 min-h-50 h-80 flex justify-start items-center flex-col text-slate-100">
          <div class="font-bold text-xl mb-2">{{ title }}</div>
          <p class="text-base">{{ subtitle }}</p>
           <img src="{{ url_for('static', filename='icons/{}'.format(icon_url)) }}" style="width: 35%; margin-top: 30px;">
       </div>

        <div class="Ccard-body absolute inset-0 bg-gray-800 rounded-lg opacity-0 transition-opacity duration-300 hover:opacity-95">
            <div class="h-full flex flex-row justify-center items-center">

                {% if options | length > 1 %}
                    {% for opt in options %}
                        <div class="h-full w-3/6">

                                <a class=" transition ease-in rounded-md flex flex-row justify-center items-center h-full w-full text-gray-300 cursor-pointer bg-gray-900 hover:bg-gray-700 hover:text-white transition ease-in" href= {{ opt.url }}>
                                    <i class="fa-solid {{ opt.icon }} fa-xl mr-2"></i> {{ opt.name }}
                                </a>

                        </div>
                    {% endfor %}
                {% else %}
                    <div class="h-full w-full">

                            <a class=" transition ease-in rounded-md flex flex-row justify-center items-center h-full w-full text-gray-300 cursor-pointer bg-gray-900 hover:bg-gray-700 hover:text-white transition ease-in" href={{ options[0].url }}>
                                <i class="fa-solid {{ options[0].icon }} fa-xl mr-2"></i> {{ options[0].name }}
                            </a>

                    </div>
                {% endif %}

            </div>
        </div>
    </div>
{% endmacro %}